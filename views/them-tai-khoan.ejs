<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/rolex-store.css">
    <link rel="stylesheet" href="/css/rolex-pages.css">
    <link rel="stylesheet" href="/css/lux-layout.css">
    <style>
        .add-page-wrap {
            max-width: 640px;
            margin: 0 auto;
            padding: 56px 24px 100px;
        }
        .add-page-header {
            display: flex;
            align-items: center;
            gap: 16px;
            margin-bottom: 40px;
            padding-bottom: 24px;
            border-bottom: 2px solid #006039;
        }
        .add-page-header__back {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-size: 0.72rem;
            font-weight: 500;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            color: #555;
            text-decoration: none;
            border: 1px solid #d4d4d4;
            padding: 8px 16px;
            transition: border-color 0.2s, color 0.2s;
            flex-shrink: 0;
        }
        .add-page-header__back:hover { border-color: #1a1a1a; color: #1a1a1a; }
        .add-page-header__back svg { width: 14px; height: 14px; stroke: currentColor; fill: none; stroke-width: 2; }
        .add-page-header h1 {
            font-family: "Segoe UI", "Helvetica Neue", Helvetica, Arial, sans-serif;
            font-size: clamp(1.4rem, 3vw, 2rem);
            font-weight: 300;
            color: #1a1a1a;
            letter-spacing: 0.03em;
            margin: 0;
        }
        .add-page-header__tag {
            font-size: 0.62rem;
            font-weight: 600;
            letter-spacing: 0.18em;
            text-transform: uppercase;
            color: #006039;
            background: rgba(0,96,57,0.08);
            padding: 4px 10px;
            margin-left: auto;
            flex-shrink: 0;
        }

        .add-form-card {
            background: #ffffff;
            border: 1px solid #e0e0e0;
            padding: 40px 44px 48px;
        }
        .add-form-group {
            display: flex;
            flex-direction: column;
            gap: 7px;
            margin-bottom: 24px;
        }
        .add-form-group label {
            font-size: 0.7rem;
            font-weight: 600;
            letter-spacing: 0.14em;
            text-transform: uppercase;
            color: #444;
        }
        .add-form-group label .req { color: #006039; margin-left: 2px; }
        .add-form-group input,
        .add-form-group select {
            border: 1px solid #d4d4d4;
            background: #fafafa;
            color: #1a1a1a;
            border-radius: 0;
            padding: 12px 14px;
            font-size: 0.92rem;
            font-family: inherit;
            outline: none;
            transition: border-color 0.2s, background 0.2s, box-shadow 0.2s;
        }
        .add-form-group input:focus,
        .add-form-group select:focus {
            border-color: #006039;
            background: #ffffff;
            box-shadow: 0 0 0 3px rgba(0,96,57,0.1);
        }
        .add-form-group input.is-invalid,
        .add-form-group select.is-invalid { border-color: #c0392b; }
        .add-form-group .hint {
            font-size: 0.76rem;
            color: #888;
            line-height: 1.5;
        }

        .role-options {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
        }
        .role-opt { position: relative; }
        .role-opt input[type="radio"] {
            position: absolute;
            opacity: 0;
            width: 0;
            height: 0;
        }
        .role-opt label {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 14px 18px;
            border: 1px solid #d4d4d4;
            cursor: pointer;
            background: #fafafa;
            transition: border-color 0.2s, background 0.2s;
            font-size: 0.8rem;
            font-weight: 400;
            letter-spacing: 0.04em;
            color: #555;
        }
        .role-opt input:checked + label {
            border-color: #006039;
            background: rgba(0,96,57,0.06);
            color: #006039;
            font-weight: 600;
        }
        .role-icon {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            font-size: 0.75rem;
            font-weight: 700;
        }
        .role-icon--user  { background: #e8f4ff; color: #1a3c6e; }
        .role-icon--admin { background: rgba(0,96,57,0.12); color: #006039; }
        .role-opt-info { display: flex; flex-direction: column; gap: 2px; }
        .role-opt-name { font-weight: 600; font-size: 0.85rem; }
        .role-opt-desc { font-size: 0.72rem; color: #888; font-weight: 400; }
        .role-opt input:checked + label .role-opt-desc { color: rgba(0,96,57,0.7); }

        .divider-label {
            font-size: 0.62rem;
            font-weight: 600;
            letter-spacing: 0.18em;
            text-transform: uppercase;
            color: #aaa;
            padding: 0 0 16px;
            border-bottom: 1px solid #ebebeb;
            margin-bottom: 24px;
        }

        .add-form-actions {
            display: flex;
            gap: 14px;
            align-items: center;
            padding-top: 12px;
            border-top: 1px solid #ebebeb;
            margin-top: 8px;
        }
        .add-form-actions .cta-btn {
            margin-top: 0;
            padding: 14px 40px;
            font-size: 0.72rem;
            letter-spacing: 0.14em;
        }
        .add-form-actions .ghost-btn { margin-top: 0; }

        .form-message {
            padding: 14px 18px;
            margin-bottom: 28px;
            font-size: 0.88rem;
            border-left: 3px solid;
        }
        .form-message.error   { background: #fff8f8; border-color: #c0392b; color: #c0392b; }
        .form-message.success { background: #f0faf4; border-color: #006039; color: #006039; }

        @media (max-width: 640px) {
            .add-form-card { padding: 28px 20px 36px; }
            .role-options { grid-template-columns: 1fr; }
        }
    </style>
</head>
<body class="page-lux">

    <%- include('partials/header') %>

    <main class="add-page-wrap">

        <div class="add-page-header">
            <a href="/quanli" class="add-page-header__back">
                <svg viewBox="0 0 24 24"><path d="M19 12H5M12 5l-7 7 7 7"/></svg>
                Quay lại
            </a>
            <h1>Thêm tài khoản mới</h1>
            <span class="add-page-header__tag">Quản lí</span>
        </div>

        <% if (message) { %>
        <div class="form-message <%= message.success ? 'success' : 'error' %>">
            <%= message.message %>
        </div>
        <% } %>

        <div class="add-form-card">
            <form method="POST" action="/quanli/them-tai-khoan" id="addAccountForm" novalidate>

                <p class="divider-label">Thông tin đăng nhập</p>

                <div class="add-form-group">
                    <label for="accountUsername">Tên đăng nhập <span class="req">*</span></label>
                    <input type="text" id="accountUsername" name="accountUsername"
                           placeholder="Ví dụ: nguyenvana"
                           value="<%= form.accountUsername || '' %>" required>
                    <span class="hint">Tối thiểu 4 ký tự. Không được trùng với tài khoản đã có.</span>
                </div>

                <div class="add-form-group">
                    <label for="accountPassword">Mật khẩu <span class="req">*</span></label>
                    <input type="password" id="accountPassword" name="accountPassword"
                           placeholder="Tối thiểu 5 ký tự" required>
                    <span class="hint">Mật khẩu sẽ được lưu, hãy chọn mật khẩu đủ mạnh.</span>
                </div>

                <div class="add-form-group">
                    <label>Vai trò <span class="req">*</span></label>
                    <div class="role-options">
                        <div class="role-opt">
                            <input type="radio" id="role-user" name="accountRole" value="user"
                                   <%= (!form.accountRole || form.accountRole === 'user') ? 'checked' : '' %>>
                            <label for="role-user">
                                <span class="role-icon role-icon--user">U</span>
                                <span class="role-opt-info">
                                    <span class="role-opt-name">Người dùng</span>
                                    <span class="role-opt-desc">Truy cập mua hàng &amp; đặt lịch</span>
                                </span>
                            </label>
                        </div>
                        <div class="role-opt">
                            <input type="radio" id="role-admin" name="accountRole" value="admin"
                                   <%= (form.accountRole === 'admin') ? 'checked' : '' %>>
                            <label for="role-admin">
                                <span class="role-icon role-icon--admin">A</span>
                                <span class="role-opt-info">
                                    <span class="role-opt-name">Quản trị viên</span>
                                    <span class="role-opt-desc">Toàn quyền quản lí hệ thống</span>
                                </span>
                            </label>
                        </div>
                    </div>
                </div>

                <p class="divider-label" style="margin-top: 8px;">Thông tin cá nhân (tùy chọn)</p>

                <div class="add-form-group">
                    <label for="accountFullName">Họ và tên</label>
                    <input type="text" id="accountFullName" name="accountFullName"
                           placeholder="Nguyễn Văn A"
                           value="<%= form.accountFullName || '' %>">
                </div>

                <div class="add-form-group">
                    <label for="accountEmail">Email</label>
                    <input type="email" id="accountEmail" name="accountEmail"
                           placeholder="email@domain.com"
                           value="<%= form.accountEmail || '' %>">
                </div>

                <div class="add-form-actions">
                    <button type="submit" class="cta-btn">Tạo tài khoản</button>
                    <a href="/quanli" class="ghost-btn">Hủy bỏ</a>
                </div>

            </form>
        </div>
    </main>

    <%- include('partials/footer') %>

    <script src="/js/auth-ui.js"></script>
    <script>
        document.getElementById('addAccountForm').addEventListener('submit', function(e) {
            const required = ['accountUsername', 'accountPassword'];
            let ok = true;
            required.forEach(function(name) {
                const el = document.getElementById(name);
                if (!el.value.trim()) { el.classList.add('is-invalid'); ok = false; }
                else el.classList.remove('is-invalid');
            });
            if (!ok) e.preventDefault();
        });
    </script>
</body>
</html>
