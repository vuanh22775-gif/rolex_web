<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/rolex-store.css">
    <link rel="stylesheet" href="/css/rolex-pages.css">
    <link rel="stylesheet" href="/css/lux-layout.css">
</head>
<body class="page-lux">

    <%- include('partials/header') %>

    <section class="lux-hero" aria-label="Đăng ký tư vấn">
        <div class="lux-hero__rail" aria-hidden="true"></div>
        <div class="lux-hero__inner">
            <h1 class="lux-hero__title">Đăng ký tư vấn mua Rolex</h1>
            <p class="lux-hero__subtitle">Để lại thông tin để chúng tôi liên hệ và tư vấn mẫu đồng hồ phù hợp nhất.</p>
            <a class="lux-hero__cta" href="#noi-dung-chinh">Khám phá thêm &gt;</a>
        </div>
        <a class="lux-hero__scroll" href="#noi-dung-chinh" aria-label="Cuộn tới nội dung">⌄</a>
    </section>

    <main class="page lux-main-wrap" id="noi-dung-chinh">
        <section class="form-wrap">

            <% if (message) { %>
            <p class="form-status <%= message.success ? 'success' : 'error' %>">
                <%= message.message %>
            </p>
            <% } %>

            <form id="registerForm" class="register-form" method="POST" action="/form" novalidate>

                <label for="fullName">Họ và tên</label>
                <input id="fullName" name="fullName" type="text" placeholder="Nguyen Van A" required>

                <label for="email">Email</label>
                <input id="email" name="email" type="email" placeholder="email@domain.com" required>

                <label for="username">Tài khoản đăng nhập</label>
                <input id="username" name="username" type="text" placeholder="Nhập tên tài khoản" required>

                <label for="password">Mật khẩu</label>
                <input id="password" name="password" type="password" placeholder="Nhập mật khẩu" required>

                <label for="phone">Số điện thoại</label>
                <input id="phone" name="phone" type="tel" placeholder="09xxxxxxxx" required>

                <label for="interest">Dòng đồng hồ quan tâm</label>
                <select id="interest" name="interest" required>
                    <option value="">Chọn bộ sưu tập</option>
                    <option value="Datejust">Datejust</option>
                    <option value="Submariner">Submariner</option>
                    <option value="GMT-Master II">GMT-Master II</option>
                    <option value="Daytona">Daytona</option>
                </select>

                <label for="message">Nhu cầu chi tiết</label>
                <textarea id="message" name="message" rows="4" placeholder="Mô tả nhu cầu của bạn..."></textarea>

                <label class="check-line">
                    <input id="agree" name="agree" type="checkbox" required>
                    Tôi đồng ý để Rolex Boutique liên hệ tư vấn.
                </label>

                <button type="submit" class="cta-btn">Gửi đăng ký</button>
            </form>
        </section>
    </main>

    <%- include('partials/footer') %>

    <script src="/js/auth-ui.js"></script>
</body>
</html>
