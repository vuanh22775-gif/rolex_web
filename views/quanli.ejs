<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/rolex-store.css">
    <link rel="stylesheet" href="/css/rolex-pages.css">
    <link rel="stylesheet" href="/css/lux-layout.css">
</head>
<body class="page-lux">

    <%- include('partials/header') %>

    <section class="lux-hero" aria-label="Quản trị">
        <div class="lux-hero__rail" aria-hidden="true"></div>
        <div class="lux-hero__inner">
            <h1 class="lux-hero__title">Bảng điều khiển quản lí</h1>
            <p class="lux-hero__subtitle" id="managerWelcome">Xin chào quản trị viên.</p>
            <a class="lux-hero__cta" href="#noi-dung-chinh">Khám phá thêm &gt;</a>
        </div>
        <a class="lux-hero__scroll" href="#noi-dung-chinh" aria-label="Cuộn tới nội dung">⌄</a>
    </section>

    <main class="page lux-main-wrap" id="noi-dung-chinh">

        <% if (added === 'product') { %>
        <div class="quanli-banner quanli-banner--success">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            Sản phẩm mới đã được thêm thành công!
            <a href="/quanli/them-san-pham" class="quanli-banner__link">Thêm tiếp</a>
        </div>
        <% } else if (added === 'account') { %>
        <div class="quanli-banner quanli-banner--success">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            Tài khoản mới đã được tạo thành công!
            <a href="/quanli/them-tai-khoan" class="quanli-banner__link">Thêm tiếp</a>
        </div>
        <% } %>

        <section class="dashboard-grid">
            <article class="info-card stat-card">
                <h2>Sản phẩm đang hiển thị</h2>
                <p class="stat-value"><%= products.length %></p>
                <p>Cập nhật danh sách bộ sưu tập theo từng mùa.</p>
            </article>
            <article class="info-card stat-card">
                <h2>Yêu cầu tư vấn</h2>
                <p class="stat-value">24</p>
                <p>Xử lý yêu cầu khách hàng trong ngày.</p>
            </article>
            <article class="info-card stat-card">
                <h2>Trạng thái hệ thống</h2>
                <p class="stat-value ok">Ổn định</p>
                <p>Không có cảnh báo hệ thống.</p>
            </article>
        </section>

        <section class="info-card wide">
            <h2>Quản lí sản phẩm</h2>
            <div class="product-management">
                <div class="management-controls">
                    <input id="searchProducts" type="text" placeholder="Tìm sản phẩm..." class="search-input">
                    <a href="/quanli/them-san-pham" class="cta-btn">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="14" height="14"><path d="M12 5v14M5 12h14"/></svg>
                        Thêm sản phẩm
                    </a>
                </div>
                <div id="productsContainer" class="products-table-container">
                    <table class="products-table">
                        <thead>
                            <tr>
                                <th>Tên sản phẩm</th>
                                <th>Mã tham chiếu</th>
                                <th>Mô tả</th>
                                <th>Giá (VND)</th>
                                <th>Bộ sưu tập</th>
                                <th>Hành động</th>
                            </tr>
                        </thead>
                        <tbody id="productsList">
                            <% if (products.length === 0) { %>
                            <tr class="empty-row">
                                <td colspan="6">Không có sản phẩm nào. Thêm sản phẩm mới để bắt đầu.</td>
                            </tr>
                            <% } else { %>
                            <% products.forEach(function(p) { %>
                            <tr>
                                <td><%= p.name %></td>
                                <td><%= p.id %></td>
                                <td><%= p.model %></td>
                                <td><%= new Intl.NumberFormat('vi-VN').format(p.price) %></td>
                                <td><span class="collection-badge collection-<%= p.collection %>"><%= p.collection.charAt(0).toUpperCase() + p.collection.slice(1) %></span></td>
                                <td class="action-buttons">
                                    <button class="edit-btn" data-id="<%= p.id %>">Sửa</button>
                                    <button class="delete-btn" data-id="<%= p.id %>">Xóa</button>
                                </td>
                            </tr>
                            <% }); %>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </section>

        <section class="info-card wide">
            <h2>Quản lí tài khoản người dùng</h2>
            <div class="account-management">
                <div class="management-controls">
                    <input id="searchAccounts" type="text" placeholder="Tìm tài khoản..." class="search-input">
                    <a href="/quanli/them-tai-khoan" class="cta-btn">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="14" height="14"><path d="M12 5v14M5 12h14"/></svg>
                        Thêm tài khoản
                    </a>
                </div>
                <div id="accountsContainer" class="accounts-table-container">
                    <table class="accounts-table">
                        <thead>
                            <tr>
                                <th>Tên đăng nhập</th>
                                <th>Vai trò</th>
                                <th>Trạng thái</th>
                                <th>Ngày tạo</th>
                                <th>Hành động</th>
                            </tr>
                        </thead>
                        <tbody id="accountsList">
                            <% if (accounts.length === 0) { %>
                            <tr class="empty-row">
                                <td colspan="5">Không có tài khoản nào.</td>
                            </tr>
                            <% } else { %>
                            <% accounts.forEach(function(a) { %>
                            <tr>
                                <td><%= a.username %></td>
                                <td><%= a.role === 'admin' ? 'Quản trị viên' : 'Người dùng' %></td>
                                <td><span class="status-badge status-active">Hoạt động</span></td>
                                <td><%= a.createdAt ? new Date(a.createdAt).toLocaleDateString('vi-VN') : 'N/A' %></td>
                                <td class="action-buttons">
                                    <button class="edit-btn" data-username="<%= a.username %>">Sửa</button>
                                    <button class="delete-btn" data-username="<%= a.username %>">Xóa</button>
                                </td>
                            </tr>
                            <% }); %>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </section>

        <section class="info-card wide">
            <h2>Quản lí đơn hàng</h2>
            <div class="products-table-container">
                <table class="products-table">
                    <thead>
                        <tr>
                            <th>Khách hàng</th>
                            <th>Sản phẩm</th>
                            <th>Tổng tiền</th>
                            <th>Thanh toán</th>
                            <th>Trạng thái</th>
                            <th>Ngày đặt</th>
                            <th>Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (orders.length === 0) { %>
                        <tr class="empty-row"><td colspan="7">Chưa có đơn hàng nào.</td></tr>
                        <% } else { %>
                        <% orders.forEach(function(o) { %>
                        <tr>
                            <td><strong><%= o.fullName %></strong><br><small><%= o.phone %></small></td>
                            <td>
                                <% o.items.forEach(function(item) { %>
                                <div><%= item.name %> x<%= item.qty %></div>
                                <% }); %>
                            </td>
                            <td><%= new Intl.NumberFormat('vi-VN').format(o.total) %> VND</td>
                            <td><%= { vnpay: 'QR/Ví', cod: 'COD', bank: 'Chuyển khoản' }[o.paymentMethod] || o.paymentMethod %></td>
                            <td>
                                <% if (o.status === 'pending') { %>
                                <span class="status-badge" style="background:#fff3cd;color:#856404;border:1px solid #ffe69c">Chờ duyệt</span>
                                <% } else if (o.status === 'approved') { %>
                                <span class="status-badge status-active">Đã duyệt</span>
                                <% } else { %>
                                <span class="status-badge" style="background:#f8d7da;color:#842029;border:1px solid #f5c2c7">Từ chối</span>
                                <% } %>
                            </td>
                            <td><%= new Date(o.createdAt).toLocaleDateString('vi-VN') %></td>
                            <td class="action-buttons">
                                <% if (o.status === 'pending') { %>
                                <form method="POST" action="/api/orders/<%= o._id %>/duyet" style="display:inline">
                                    <button type="submit" class="edit-btn">Duyệt</button>
                                </form>
                                <form method="POST" action="/api/orders/<%= o._id %>/tuchoi" style="display:inline">
                                    <button type="submit" class="delete-btn">Từ chối</button>
                                </form>
                                <% } else { %>
                                —
                                <% } %>
                            </td>
                        </tr>
                        <% }); %>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </section>

        <section class="info-card wide">
            <h2>Tác vụ nhanh khác</h2>
            <div class="quick-actions">
                <a href="/quanli/hoadon" class="cta-btn">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="14" height="14"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                    Quản lý Doanh thu & Hóa đơn
                </a>
                <a href="/form" class="cta-btn">Xem form đăng ký</a>
                <a href="/" class="cta-btn">Về trang chủ</a>
            </div>
        </section>
    </main>

    <!-- Modal thêm/sửa sản phẩm -->
    <div id="productModal" class="modal" aria-hidden="true">
        <div class="modal-content">
            <div class="modal-header">
                <h2 id="modalTitle">Thêm sản phẩm mới</h2>
                <button id="closeModalBtn" class="close-btn" aria-label="Đóng">&times;</button>
            </div>
            <form id="productForm" class="product-form">
                <div class="form-group">
                    <label for="productName">Tên sản phẩm *</label>
                    <input type="text" id="productName" name="productName" required placeholder="Ví dụ: Submariner Date">
                </div>
                <div class="form-group">
                    <label for="productId">Mã tham chiếu *</label>
                    <input type="text" id="productId" name="productId" required placeholder="Ví dụ: 126610LN">
                </div>
                <div class="form-group">
                    <label for="productModel">Mô tả *</label>
                    <input type="text" id="productModel" name="productModel" required placeholder="Ví dụ: Oyster 41 mm - Black ceramic bezel">
                </div>
                <div class="form-group">
                    <label for="productPrice">Giá (VND) *</label>
                    <input type="number" id="productPrice" name="productPrice" required min="0" placeholder="340000000">
                </div>
                <div class="form-group">
                    <label for="productCollection">Bộ sưu tập *</label>
                    <select id="productCollection" name="productCollection" required>
                        <option value="">Chọn bộ sưu tập</option>
                        <option value="classic">Classic</option>
                        <option value="sport">Sport</option>
                        <option value="diving">Diving</option>
                        <option value="luxury">Luxury</option>
                    </select>
                </div>
                <div class="form-group">
                    <label for="productImage">Đường dẫn hình ảnh</label>
                    <input type="text" id="productImage" name="productImage" placeholder="Ví dụ: media/submariner.avif">
                </div>
                <div class="form-actions">
                    <button type="submit" class="cta-btn">Lưu sản phẩm</button>
                    <button type="button" id="cancelBtn" class="ghost-btn">Hủy</button>
                </div>
            </form>
        </div>
    </div>
    <div id="modalOverlay" class="modal-overlay"></div>

    <!-- Modal thêm/sửa tài khoản -->
    <div id="accountModal" class="modal" aria-hidden="true">
        <div class="modal-content">
            <div class="modal-header">
                <h2 id="accountModalTitle">Thêm tài khoản mới</h2>
                <button id="closeAccountModalBtn" class="close-btn" aria-label="Đóng">&times;</button>
            </div>
            <form id="accountForm" class="product-form">
                <div class="form-group">
                    <label for="accountUsername">Tên đăng nhập *</label>
                    <input type="text" id="accountUsername" name="accountUsername" required placeholder="Nhập tên đăng nhập">
                </div>
                <div class="form-group">
                    <label for="accountPassword">Mật khẩu *</label>
                    <input type="password" id="accountPassword" name="accountPassword" placeholder="Nhập mật khẩu">
                </div>
                <div class="form-group">
                    <label for="accountRole">Vai trò *</label>
                    <select id="accountRole" name="accountRole" required>
                        <option value="">Chọn vai trò</option>
                        <option value="user">Người dùng</option>
                        <option value="admin">Quản trị viên</option>
                    </select>
                </div>
                <div id="passwordNote" class="form-note" style="display: none;">
                    Bỏ trống để giữ nguyên mật khẩu hiện tại
                </div>
                <div class="form-actions">
                    <button type="submit" class="cta-btn">Lưu tài khoản</button>
                    <button type="button" id="cancelAccountBtn" class="ghost-btn">Hủy</button>
                </div>
            </form>
        </div>
    </div>
    <div id="accountModalOverlay" class="modal-overlay"></div>

    <%- include('partials/footer') %>

    <!-- Dữ liệu từ server cho quanli.js -->
    <script>
        window.ROLEX_PRODUCTS_SERVER = <%- JSON.stringify(products) %>;
        window.ROLEX_ACCOUNTS_SERVER = <%- JSON.stringify(accounts) %>;
    </script>
    <script src="/js/auth-ui.js"></script>
    <script src="/js/quanli.js"></script>
</body>
</html>
