<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/rolex-store.css">
    <link rel="stylesheet" href="/css/rolex-pages.css">
    <link rel="stylesheet" href="/css/lux-layout.css">
    <style>
        .add-page-wrap {
            max-width: 760px;
            margin: 0 auto;
            padding: 56px 24px 100px;
        }
        .add-page-header {
            display: flex;
            align-items: center;
            gap: 16px;
            margin-bottom: 40px;
            padding-bottom: 24px;
            border-bottom: 2px solid #006039;
        }
        .add-page-header__back {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            font-size: 0.72rem;
            font-weight: 500;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            color: #555;
            text-decoration: none;
            border: 1px solid #d4d4d4;
            padding: 8px 16px;
            transition: border-color 0.2s, color 0.2s;
            flex-shrink: 0;
        }
        .add-page-header__back:hover { border-color: #1a1a1a; color: #1a1a1a; }
        .add-page-header__back svg { width: 14px; height: 14px; stroke: currentColor; fill: none; stroke-width: 2; }
        .add-page-header h1 {
            font-family: "Segoe UI", "Helvetica Neue", Helvetica, Arial, sans-serif;
            font-size: clamp(1.4rem, 3vw, 2rem);
            font-weight: 300;
            color: #1a1a1a;
            letter-spacing: 0.03em;
            margin: 0;
        }
        .add-page-header__tag {
            font-size: 0.62rem;
            font-weight: 600;
            letter-spacing: 0.18em;
            text-transform: uppercase;
            color: #006039;
            background: rgba(0,96,57,0.08);
            padding: 4px 10px;
            margin-left: auto;
            flex-shrink: 0;
        }

        .add-form-card {
            background: #ffffff;
            border: 1px solid #e0e0e0;
            padding: 40px 44px 48px;
        }
        .add-form-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 0 28px;
        }
        .add-form-group {
            display: flex;
            flex-direction: column;
            gap: 7px;
            margin-bottom: 24px;
        }
        .add-form-group.full-width { grid-column: 1 / -1; }
        .add-form-group label {
            font-size: 0.7rem;
            font-weight: 600;
            letter-spacing: 0.14em;
            text-transform: uppercase;
            color: #444;
        }
        .add-form-group label .req { color: #006039; margin-left: 2px; }
        .add-form-group input,
        .add-form-group select,
        .add-form-group textarea {
            border: 1px solid #d4d4d4;
            background: #fafafa;
            color: #1a1a1a;
            border-radius: 0;
            padding: 11px 14px;
            font-size: 0.92rem;
            font-family: inherit;
            outline: none;
            transition: border-color 0.2s, background 0.2s, box-shadow 0.2s;
        }
        .add-form-group input:focus,
        .add-form-group select:focus,
        .add-form-group textarea:focus {
            border-color: #006039;
            background: #ffffff;
            box-shadow: 0 0 0 3px rgba(0,96,57,0.1);
        }
        .add-form-group input.is-invalid,
        .add-form-group select.is-invalid { border-color: #c0392b; }
        .add-form-group .hint {
            font-size: 0.76rem;
            color: #888;
            line-height: 1.5;
        }
        .add-form-group textarea { resize: vertical; min-height: 80px; }

        .price-prefix-wrap {
            display: flex;
            align-items: stretch;
        }
        .price-prefix {
            background: #f0f0f0;
            border: 1px solid #d4d4d4;
            border-right: none;
            padding: 0 14px;
            display: flex;
            align-items: center;
            font-size: 0.78rem;
            color: #666;
            letter-spacing: 0.06em;
            white-space: nowrap;
            flex-shrink: 0;
        }
        .price-prefix-wrap input { flex: 1; }

        .collection-options {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 8px;
        }
        .collection-opt {
            position: relative;
        }
        .collection-opt input[type="radio"] {
            position: absolute;
            opacity: 0;
            width: 0;
            height: 0;
        }
        .collection-opt label {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 4px;
            padding: 14px 10px 12px;
            border: 1px solid #d4d4d4;
            cursor: pointer;
            background: #fafafa;
            transition: border-color 0.2s, background 0.2s;
            font-size: 0.68rem;
            font-weight: 600;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            color: #555;
        }
        .collection-opt label .dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            margin-bottom: 2px;
        }
        .collection-opt input:checked + label {
            border-color: #006039;
            background: rgba(0,96,57,0.06);
            color: #006039;
        }
        .dot-classic { background: #8a7535; }
        .dot-sport   { background: #1a3c6e; }
        .dot-diving  { background: #006039; }
        .dot-luxury  { background: #640050; }

        .add-form-actions {
            display: flex;
            gap: 14px;
            align-items: center;
            padding-top: 12px;
            border-top: 1px solid #ebebeb;
            margin-top: 8px;
        }
        .add-form-actions .cta-btn {
            margin-top: 0;
            padding: 14px 40px;
            font-size: 0.72rem;
            letter-spacing: 0.14em;
        }
        .add-form-actions .ghost-btn { margin-top: 0; }

        .form-message {
            padding: 14px 18px;
            margin-bottom: 28px;
            font-size: 0.88rem;
            border-left: 3px solid;
        }
        .form-message.error   { background: #fff8f8; border-color: #c0392b; color: #c0392b; }
        .form-message.success { background: #f0faf4; border-color: #006039; color: #006039; }

        @media (max-width: 640px) {
            .add-form-card { padding: 28px 20px 36px; }
            .add-form-grid { grid-template-columns: 1fr; }
            .collection-options { grid-template-columns: repeat(2, 1fr); }
        }
    </style>
</head>
<body class="page-lux">

    <%- include('partials/header') %>

    <main class="add-page-wrap">

        <div class="add-page-header">
            <a href="/quanli" class="add-page-header__back">
                <svg viewBox="0 0 24 24"><path d="M19 12H5M12 5l-7 7 7 7"/></svg>
                Quay lại
            </a>
            <h1>Thêm sản phẩm mới</h1>
            <span class="add-page-header__tag">Quản lí</span>
        </div>

        <% if (message) { %>
        <div class="form-message <%= message.success ? 'success' : 'error' %>">
            <%= message.message %>
        </div>
        <% } %>

        <div class="add-form-card">
            <form method="POST" action="/quanli/them-san-pham" id="addProductForm" novalidate>

                <div class="add-form-grid">

                    <div class="add-form-group">
                        <label for="productName">Tên sản phẩm <span class="req">*</span></label>
                        <input type="text" id="productName" name="productName"
                               placeholder="Ví dụ: Submariner Date"
                               value="<%= form.productName || '' %>" required>
                    </div>

                    <div class="add-form-group">
                        <label for="productId">Mã tham chiếu (Ref.) <span class="req">*</span></label>
                        <input type="text" id="productId" name="productId"
                               placeholder="Ví dụ: 126610LN"
                               value="<%= form.productId || '' %>" required>
                        <span class="hint">Mã phải là duy nhất trong hệ thống.</span>
                    </div>

                    <div class="add-form-group full-width">
                        <label for="productModel">Mô tả kỹ thuật <span class="req">*</span></label>
                        <input type="text" id="productModel" name="productModel"
                               placeholder="Ví dụ: Oyster 41 mm - Black ceramic bezel"
                               value="<%= form.productModel || '' %>" required>
                    </div>

                    <div class="add-form-group">
                        <label for="productPrice">Giá bán (VND) <span class="req">*</span></label>
                        <div class="price-prefix-wrap">
                            <span class="price-prefix">VND</span>
                            <input type="number" id="productPrice" name="productPrice"
                                   placeholder="340000000" min="0"
                                   value="<%= form.productPrice || '' %>" required>
                        </div>
                        <span class="hint">Nhập số nguyên, không dấu chấm/phẩy.</span>
                    </div>

                    <div class="add-form-group">
                        <label for="productStock">Số lượng tồn kho <span class="req">*</span></label>
                        <input type="number" id="productStock" name="productStock"
                               placeholder="1" min="0" step="1"
                               value="<%= form.productStock ?? '' %>" required>
                        <span class="hint">Số chiếc có thể bán ngay lúc này.</span>
                    </div>

                    <div class="add-form-group">
                        <label for="productImage">Đường dẫn hình ảnh</label>
                        <input type="text" id="productImage" name="productImage"
                               placeholder="media/submariner.avif"
                               value="<%= form.productImage || '' %>">
                        <span class="hint">Để trống nếu chưa có ảnh.</span>
                    </div>

                    <div class="add-form-group full-width">
                        <label>Bộ sưu tập <span class="req">*</span></label>
                        <div class="collection-options">
                            <div class="collection-opt">
                                <input type="radio" id="col-classic" name="productCollection" value="classic"
                                       <%= (form.productCollection === 'classic') ? 'checked' : '' %>>
                                <label for="col-classic">
                                    <span class="dot dot-classic"></span>
                                    Classic
                                </label>
                            </div>
                            <div class="collection-opt">
                                <input type="radio" id="col-sport" name="productCollection" value="sport"
                                       <%= (form.productCollection === 'sport') ? 'checked' : '' %>>
                                <label for="col-sport">
                                    <span class="dot dot-sport"></span>
                                    Sport
                                </label>
                            </div>
                            <div class="collection-opt">
                                <input type="radio" id="col-diving" name="productCollection" value="diving"
                                       <%= (form.productCollection === 'diving') ? 'checked' : '' %>>
                                <label for="col-diving">
                                    <span class="dot dot-diving"></span>
                                    Diving
                                </label>
                            </div>
                            <div class="collection-opt">
                                <input type="radio" id="col-luxury" name="productCollection" value="luxury"
                                       <%= (form.productCollection === 'luxury') ? 'checked' : '' %>>
                                <label for="col-luxury">
                                    <span class="dot dot-luxury"></span>
                                    Luxury
                                </label>
                            </div>
                        </div>
                    </div>

                </div>

                <div class="add-form-actions">
                    <button type="submit" class="cta-btn">Lưu sản phẩm</button>
                    <a href="/quanli" class="ghost-btn">Hủy bỏ</a>
                </div>

            </form>
        </div>
    </main>

    <%- include('partials/footer') %>

    <script src="/js/auth-ui.js"></script>
    <script>
        /* Validate nhẹ phía client trước khi submit */
        document.getElementById('addProductForm').addEventListener('submit', function(e) {
            const required = ['productName', 'productId', 'productModel', 'productPrice', 'productStock'];
            let ok = true;
            required.forEach(function(name) {
                const el = document.getElementById(name);
                if (!el.value.trim()) { el.classList.add('is-invalid'); ok = false; }
                else el.classList.remove('is-invalid');
            });
            const coll = document.querySelector('input[name="productCollection"]:checked');
            if (!coll) {
                document.querySelector('.collection-options').style.outline = '2px solid #c0392b';
                ok = false;
            }
            if (!ok) e.preventDefault();
        });
    </script>
</body>
</html>
