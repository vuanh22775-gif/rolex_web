# MongoDB connection string (use a replica-set URI if you need multi-document transactions)
MONGODB_URI=mongodb://localhost:27017/rolex_boutique
SESSION_SECRET=replace-with-a-long-random-secret
PORT=3000

# Optional one-time admin bootstrap for a new database
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=

# Set to production in deployed environments
NODE_ENV=development
